# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commite)
APP_ENV=dev

# --- Lancement direct (uvicorn + PostgreSQL installe sur la machine) ---
# Role applicatif (API) : lecture employes, ajout/lecture predictions
DATABASE_URL=postgresql+psycopg://technova_app:changeme@localhost:5432/technova
# Role proprietaire (scripts create_db.py / load_dataset.py)
DATABASE_ADMIN_URL=postgresql+psycopg://technova_admin:changeme@localhost:5432/technova
MODEL_PATH=app/ml/model.joblib

# --- Deploiement Docker (docker compose) : mots de passe de la base du conteneur ---
# Lettres et chiffres uniquement (ils sont inseres dans des URL de connexion)
POSTGRES_ADMIN_PASSWORD=changeme-admin
POSTGRES_APP_PASSWORD=changeme-app
API_PORT=8000

# Cle exigee dans l'en-tete X-API-Key (laisser vide en local pour un acces libre)
API_KEY=changeme-cle-api
